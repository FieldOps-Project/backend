{
  "info": {
    "name": "FieldOps API",
    "description": "Collection para testar os endpoints da API FieldOps.\n\nFluxo sugerido: Auth > Login, depois Clients > Create client, Sites > Create site e Equipment > Create equipment.\nOs requests de criacao salvam os ids nas variaveis da collection para os requests seguintes.\n\nVariaveis:\n- `baseUrl`: URL base da API (default: http://localhost:8080)\n- `adminEmail` / `adminPassword`: credenciais usadas no login\n- `accessToken` / `refreshToken`: preenchidos pelo login e pelo refresh\n- `userId`, `clientId`, `siteId`, `equipmentId`, `qrCode`: preenchidos pelos requests de criacao",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@fieldops.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "siteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "equipmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "qrCode",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
